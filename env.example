# PostgreSQL Database
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/luna_bar"

# Pusher Real-time (sign up at https://pusher.com - free tier)
PUSHER_APP_ID=your_app_id
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# App Configuration
APP_NAME=bar-luna
PORT=4000
NEXT_PUBLIC_APP_URL=http://localhost:4000

# NextAuth Secret (generate random string - used for session encryption)
NEXTAUTH_SECRET=change-this-to-random-secure-string

# Web Push Notifications (VAPID keys - generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key_KEEP_SECRET

# Upload Directory (required in production - set to your upload directory path)
# Example: UPLOAD_DIR=/var/www/uploads/bar-luna
# If not set, defaults to public/uploads (for local development only)

